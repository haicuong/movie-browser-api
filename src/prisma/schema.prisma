datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  name      String
  favorites Favorite[]

  @@map("users")
}

model Favorite {
  userId    Int      @map("user_id")
  tmdbId    Int      @map("tmdb_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [tmdbId], references: [tmdbId], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, tmdbId])
  @@map("favorites")
}

model Movie {
  tmdbId     Int        @id @map("tmdb_id")
  title      String
  overview   String
  posterPath String?    @map("poster_path")
  favorites  Favorite[]

  @@map("movies")
}
